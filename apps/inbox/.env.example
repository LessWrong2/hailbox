# Postgres. Locally defaults to postgres://localhost/hailbox.
DATABASE_URL=

# Redis, for fanning out realtime events between function instances. Required on Vercel;
# without it, events only reach sockets held by the same instance. KV_URL (as set by
# Upstash's Vercel integration) works too.
REDIS_URL=

# Long random string used to sign unsubscribe links. Required in production.
HAILBOX_SECRET=

# Public URL of this inbox, used in emails and Slack links. Defaults to the Vercel URL.
HAILBOX_INBOX_URL=

# Shown in notification emails ("New reply from Acme").
HAILBOX_SITE_NAME=

# Comma-separated origins allowed to embed the widget, e.g. https://example.com. Defaults to *.
# Reply emails only link back to pages on these origins, so set it to get that link.
HAILBOX_ALLOWED_ORIGINS=

# Comma-separated emails allowed to sign in to the inbox.
OPERATOR_EMAILS=

# Seconds to wait before emailing a visitor about an unread reply (default 60, max 240).
NOTIFY_DELAY_SECONDS=

# Mailgun. Without these, emails are logged to the console (and sign-in links shown on screen) in development.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
# https://api.eu.mailgun.net for EU domains
MAILGUN_API_BASE=

# Slack: either a bot token (chat:write) + channel ID for one thread per conversation,
# or an incoming webhook URL for flat messages.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=

# Preview deployments skip migrations, in case they share production's database. Set to 1 if
# each preview gets its own database branch (e.g. Neon's Vercel integration).
HAILBOX_MIGRATE_PREVIEWS=

# Local dev server bind address (default localhost). In development anyone can sign in, so
# don't expose it.
HAILBOX_DEV_HOST=
